# The public demo: Maya and Theo with sample data, wiped and refilled every hour (server/scripts/demo.ts --hosted).
# Not for real nodes: it runs from source with the dev tools the demo script needs, and keeps nothing.
FROM node:22-alpine
RUN apk add --no-cache python3 make g++
WORKDIR /app
COPY package.json package-lock.json ./
COPY server/package.json server/
COPY web/package.json web/
RUN npm ci
COPY . .
RUN npm run build -w web
ENV DEMO_RESET_MINUTES=60 PORT=4000
EXPOSE 4000
CMD ["npm", "run", "demo", "-w", "server", "--", "--hosted"]
